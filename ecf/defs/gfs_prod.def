suite gfs_v17_fcst_only
  family primary
    edit gfs_ver 'v17.0'
    edit PACKAGEHOME '/lfs/h2/emc/global/noscrub/David.Huber/GW/gfs/git/release/gfs.v17.0.0'
    edit NET 'gfs'
    edit RUN 'gfs'
    edit PROJ 'GFS'
    edit PROJENVIR 'DEV'
    edit MACHINE_SITE 'development'
    edit ENVIR 'prod'
    edit QUEUE 'dev'
    edit QUEUE_ARCH 'dev_transfer'
    edit OUTPUTDIR '/lfs/h2/emc/ptmp/david.huber/ecflow_gfs_fcst_only/para/output/prod/today'
    edit EXPDIR '/lfs/h2/emc/global/noscrub/David.Huber/GW/gfs/git/release/gfs.v17.0.0/parm/config/gfs'
    edit DATAROOT '/lfs/h2/emc/stmp/david.huber/ecflow_gfs_fcst_only'
    edit ECF_INCLUDE '/lfs/h2/emc/global/noscrub/David.Huber/GW/gfs/git/release/gfs.v17.0.0/ecf/include'
    family 06
      edit CYC '06'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_tropcy_qc_reloc
              #event 1 jtwc_bull_email
              trigger :TIME >= 0841 and :TIME < 0845
            task jgfs_atmos_emcsfc_sfc_prep
              #NCO/Ops should use obsproc trigger.  Time trigger is a workaround for development
              #trigger /gfs_v17_0/primary/06/obsproc/v1.3/gfs/atmos/dump/jobsproc_gfs_atmos_dump:release_sfcprep
              trigger :TIME >= 0907 and :TIME < 0912
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_obs_bufr_dump
              # TODO make this trigger off of obsproc dump job completion
              trigger :TIME >= 0907 and :TIME < 0912 
            task jgfs_marine_obs_dump
              # this should start when the obsproc job starts
              trigger :TIME >= 0845 and :TIME < 1230
          endfamily		//marine
        endfamily		//prep
        family init
          family wave
            edit WGF 'wave'
            task jgfs_wave_init
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/06/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
          endfamily		//wave
        endfamily		//init
        family analysis
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_anal
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger  /gfs_v17_0/primary/06/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete and  ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
            task jgfs_atmos_anal_sfc_gcycle
              trigger jgfs_atmos_anal==complete and ../snow/jgfs_atmos_analsnow==complete
            task jgfs_atmos_anal_calc
              trigger jgfs_atmos_anal_sfc_gcycle==complete
            task jgfs_atmos_analupp
              trigger jgfs_atmos_anal_calc==complete
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_bmat_init
              # TODO make this trigger off of obsproc dump job completion
              trigger ../../prep/marine/jgfs_marine_obs_dump==complete
            task jgfs_marine_bmat
              trigger jgfs_marine_bmat_init==complete
            task jgfs_marine_anal_init
              trigger jgfs_marine_bmat==complete and ../../prep/marine/jgfs_marine_obs_dump==complete and ../../prep/marine/jgfs_marine_obs_bufr_dump==complete
            task jgfs_marine_analvar
              trigger jgfs_marine_anal_init==complete
            task jgfs_marine_analchkpt
              trigger jgfs_marine_analvar==complete
            task jgfs_marine_analfinal
              trigger jgfs_marine_analchkpt==complete
          endfamily		//marine
          family snow
            edit WGF 'snow'
            task jgfs_atmos_analsnow
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/06/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
          endfamily		//snow
        endfamily		//analysis
      endfamily // gfs
    endfamily			//06

    family 12
      edit CYC '12'
      edit ECF_FILES '%PACKAGEHOME%/ecf/scripts'
      family gfs
        edit RUN 'gfs'
        family prep
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_tropcy_qc_reloc
              #event 1 jtwc_bull_email
              trigger :TIME >= 1441 and :TIME < 1445
            task jgfs_atmos_emcsfc_sfc_prep
              #NCO/Ops should use obsproc trigger.  Time trigger is a workaround for development
              #trigger /gfs_v17_0/primary/12/obsproc/v1.3/gfs/atmos/dump/jobsproc_gfs_atmos_dump:release_sfcprep
              trigger :TIME >= 1507 and :TIME < 1512
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_obs_bufr_dump
              # TODO make this trigger off of obsproc dump job completion
              trigger :TIME >= 1507 and :TIME < 1512 
            task jgfs_marine_obs_dump
              # this should start when the obsproc job starts
              trigger :TIME >= 1445 and :TIME < 1830
          endfamily		//marine
        endfamily		//prep
        family init
          family wave
            edit WGF 'wave'
            task jgfs_wave_init
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/12/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
          endfamily		//wave
        endfamily		//init
        family analysis
          family atmos
            edit WGF 'atmos'
            task jgfs_atmos_anal
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger  /gfs_v17_0/primary/12/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete and  ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
            task jgfs_atmos_anal_sfc_gcycle
              trigger jgfs_atmos_anal==complete and ../snow/jgfs_atmos_analsnow==complete
            task jgfs_atmos_anal_calc
              trigger jgfs_atmos_anal_sfc_gcycle==complete
            task jgfs_atmos_analupp
              trigger jgfs_atmos_anal_calc==complete
          endfamily		//atmos
          family marine
            edit WGF 'marine'
            task jgfs_marine_bmat_init
              # TODO make this trigger off of obsproc dump job completion
              trigger ../../prep/marine/jgfs_marine_obs_dump==complete
            task jgfs_marine_bmat
              trigger jgfs_marine_bmat_init==complete
            task jgfs_marine_anal_init
              trigger jgfs_marine_bmat==complete and ../../prep/marine/jgfs_marine_obs_dump==complete and ../../prep/marine/jgfs_marine_obs_bufr_dump==complete
            task jgfs_marine_analvar
              trigger jgfs_marine_anal_init==complete
            task jgfs_marine_analchkpt
              trigger jgfs_marine_analvar==complete
            task jgfs_marine_analfinal
              trigger jgfs_marine_analchkpt==complete
          endfamily		//marine
          family snow
            edit WGF 'snow'
            task jgfs_atmos_analsnow
              #NCO/Ops should use obsproc trigger.  Sfc prep trigger is a workaround for development
              #trigger /gfs_v17_0/primary/12/obsproc/v1.3/gfs/atmos/prep/jobsproc_gfs_atmos_prep == complete
              trigger ../../prep/atmos/jgfs_atmos_emcsfc_sfc_prep==complete
          endfamily		//snow
        endfamily		//analysis
        family forecast
          task jgfs_fcst
            trigger ../analysis/atmos/jgfs_atmos_analupp==complete and ../init==complete and ../analysis/marine==complete
            event 1683 release_gfs_fcst_manager
        endfamily		//forecast
      endfamily			//gfs
    endfamily			//12
  endfamily			//primary
endsuite			//gfs_v17_0
