&atmos_model_nml
  blocksize = @[blocksize]
  dycore_only = @[dycore_only]
  ccpp_suite = '@[CCPP_SUITE]'
  ic_filename = '@[mpas_ic_filename]'
  oro_filename = '@[mpas_oro_filename]'
  stream_list_history = '@[mpas_stream_list_history]'
  stream_list_restart = '@[mpas_stream_list_restart]'
  stream_list_diag    = '@[mpas_stream_list_diag]'
  phys_diag = @[mpas_phys_diag]
  regional = false
/

&fms_nml
  clock_grain = 'ROUTINE'
  domains_stack_size = 3000000
  print_memory_usage = .false.
/

&fms2_io_nml
  netcdf_default_format = "netcdf4"
/

&mpas_nhyd_model
  mpas_time_integration_order   = 2
  mpas_dt                       = @[DELTIM].0
  mpas_split_dynamics_transport = true
  mpas_number_of_sub_steps      = 4
  mpas_dynamics_split_steps     = 3
  mpas_horiz_mixing             = '2d_smagorinsky'
  mpas_visc4_2dsmag             = 0.05
  mpas_scalar_advection         = true
  mpas_monotonic                = true
  mpas_coef_3rd_order           = 0.25
  mpas_smdiv                    = 0.1
/
&mpas_damping
  mpas_zd                        = 22000.0
  mpas_xnutr                     = 0.2
/

&mpas_limited_area
  mpas_apply_lbcs = .false.
/

&mpas_io
  mpas_pio_num_iotasks = @[mpas_pio_num_iotasks]
  mpas_pio_stride = 1
/

&mpas_assimilation
  mpas_jedi_da = .false.
/

&mpas_decomposition
  mpas_block_decomp_file_prefix = '@[mpas_graph_prefix]'
/

&mpas_restart
  mpas_do_restart = .false.
/

&mpas_printout
  mpas_print_global_minmax_vel   = .false.
  mpas_print_detailed_minmax_vel = .false.
  mpas_print_global_minmax_sca   = .false.
/

&mpas_physics
  mpas_sfc_albedo  = .false.
  mpas_frac_seaice = .true.
  mpas_lsm_scheme  = 'sf_ruc'
/

&mpas_nam_stochy
  mpas_do_sppt       = .false.
  mpas_do_skeb       = .false.
  mpas_spptint       = 0
  mpas_sppt_1        = 0.1
  mpas_sppt_2        = 0.1
  mpas_sppt_3        = 0.1
  mpas_sppt_tau_1    = 21600.
  mpas_sppt_tau_2    = 86400.
  mpas_sppt_tau_3    = 21600.
  mpas_sppt_lscale_1 = 500000.
  mpas_sppt_lscale_2 = 1000000.
  mpas_sppt_lscale_3 = 2000000.
  mpas_sppt_logit    = .true.
  mpas_sppt_sfclimit = .true.
  mpas_iseed_sppt1   = 2026010112001
  mpas_iseed_sppt2   = 0
  mpas_iseed_sppt3   = 0
  mpas_sppt_hgt_top1 = 15000
  mpas_sppt_hgt_top2 = 27000
  mpas_stochini      = .false.
/

&gfs_physics_nml
  fhzero       = @[FHZERO]
  h2o_phys     = .true.
  ldiag3d      = .false.
  qdiag3d      = .false.
  print_diff_pgr = .false.
  fhcyc        = @[FHCYC]
  use_ufo      = .true.
  pre_rad      = .false.
  imp_physics  = @[imp_physics]
  pdfcld       = .false.
  fhswr        = 3600.
  fhlwr        = 3600.
  ialb         = 1
  iems         = 1
  iaer         = @[IAER]
  icliq_sw     = 2
  iovr         = 3
  ico2         = 2
  isubc_sw     = 2
  isubc_lw     = 2
  isol         = 2
  lwhtr        = .true.
  swhtr        = .true.
  cnvgwd       = .true.
  shal_cnv     = .true.
  cal_pre      = .false.
  redrag       = .true.
  dspheat      = .true.
  hybedmf      = .false.
  satmedmf     = .true.
  isatmedmf    = 1
  lheatstrg    = .false.
  lseaspray    = .true.
  random_clds  = .false.
  trans_trac   = .true.
  cnvcld       = .true.
  imfshalcnv   = 2
  imfdeepcnv   = 2
  ras          = .false.
  cdmbgwd      = @[cdmbgwd]
  prslrd0      = 0.
  ivegsrc      = 1
  isot         = 1
  lsoil        = 4
  lsm          = 1
  iopt_dveg    = 1
  iopt_crs     = 1
  iopt_btr     = 1
  iopt_run     = 1
  iopt_sfc     = 1
  iopt_frz     = 1
  iopt_inf     = 1
  iopt_rad     = 1
  iopt_alb     = 2
  iopt_snf     = 4
  iopt_tbot    = 2
  iopt_stc     = 1
  iopt_trs     = 2
  iopt_diag    = 2
  debug        = .false.
  oz_phys      = .false.
  oz_phys_2015 = .true.
  nstf_name    = 2,0,0,0,0
  nst_anl      = .true.
  psautco      = 0.0008,0.0005
  prautco      = 0.00015,0.00015
  lgfdlmprad   = .true.
  cplchm       = .false.
  cplwav       = .false.
  cplwav2atm   = .false.
  effr_in      = .true.
  gwd_opt      = 2
  do_gsl_drag_ls_bl    = .true.
  do_gsl_drag_ss       = .false.
  do_gsl_drag_tofd     = .true.
  do_ugwp_v0           = .false.
  do_ugwp_v0_orog_only = .false.
  do_ugwp_v0_nst_only  = .false.
  do_ugwp_v1           = .true.
  do_ugwp_v1_w_gsldrag = .false.
  ldiag_ugwp   = .false.
  do_ugwp      = .false.
  do_tofd      = .true.
  do_sppt      = .false.
  do_shum      = .false.
  do_skeb      = .false.
  lndp_type    = 0
  n_var_lndp   = 0
  fscav_aero   = '*:0.3','so2:0.0','msa:0.0','dms:0.0','nh3:0.4','nh4:0.6','bc1:0.6','bc2:0.6','oc1:0.4','oc2:0.4','dust1:0.6','dust2:0.6','dust3:0.6','dust4:0.6','dust5:0.6','seas1:0.5','seas2:0.5','seas3:0.5','seas4:0.5','seas5:0.5'
  do_RRTMGP          = .false.
  active_gases       = 'h2o_co2_o3_n2o_ch4_o2'
  ngases             = 6
  lw_file_gas        = 'rrtmgp-data-lw-g128-210809.nc'
  lw_file_clouds     = 'rrtmgp-cloud-optics-coeffs-lw.nc'
  sw_file_gas        = 'rrtmgp-data-sw-g112-210809.nc'
  sw_file_clouds     = 'rrtmgp-cloud-optics-coeffs-sw.nc'
  rrtmgp_nGptsSW     = 112
  rrtmgp_nGptsLW     = 128
  rrtmgp_nBandsLW    = 16
  rrtmgp_nBandsSW    = 14
  rrtmgp_lw_phys_blksz = 16
  doGP_lwscat        = .true.
  progsigma    = .false.
  tend_opt_swrad = 4
  tend_opt_lwrad = 4
  tend_opt_rad_scaler = 2
  tend_opt_photochem = 2
  tend_opt_gwd = 2
  tend_opt_mp = 2
/

&cires_ugwp_nml
  knob_ugwp_solver   = 2
  knob_ugwp_source   = 1,1,0,0
  knob_ugwp_wvspec   = 1,25,25,25
  knob_ugwp_azdir    = 2,4,4,4
  knob_ugwp_stoch    = 0,0,0,0
  knob_ugwp_effac    = 1,1,1,1
  knob_ugwp_doaxyz   = 1
  knob_ugwp_doheat   = 1
  knob_ugwp_dokdis   = 2
  knob_ugwp_ndx4lh   = 4
  knob_ugwp_version  = 1
  knob_ugwp_palaunch = 275.0e2
  knob_ugwp_nslope   = 1
  knob_ugwp_lzmax    = 15.750e3
  knob_ugwp_lzmin    = 0.75e3
  knob_ugwp_lzstar   = 2.0e3
  knob_ugwp_taumin   = 0.25e-3
  knob_ugwp_tauamp   = 3.0e-3
  knob_ugwp_lhmet    = 200.0e3
  knob_ugwp_orosolv  = 'pss-1986'
/
