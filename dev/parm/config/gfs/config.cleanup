#! /usr/bin/env bash

########## config.cleanup ##########
echo "BEGIN: config.cleanup"

# Get task specific resources
source "${EXPDIR}/config.resources" cleanup

export CLEANUP_COM="YES"   # NO=retain ROTDIR.  YES default in cleanup.sh

#--starting and ending hours of previous cycles to be removed from rotating directory
export RMOLDSTD=144
export RMOLDEND=24

#--starting and ending hours for GEMPAK files when DO_GEMPAK=YES
#  These define the extended retention period for GEMPAK 1.0 degree files only
export RMOLDSTD_GEMPAK=346
export RMOLDEND_GEMPAK=222

if [[ "${DO_GEMPAK}" == "YES" && "${RUN}" == "gfs" ]]; then
    # When GEMPAK is enabled, we clean up in stages:
    # 1. Standard cleanup (RMOLDEND to RMOLDEND_GEMPAK): Remove all non-GEMPAK data
    # 2. GEMPAK cleanup (RMOLDEND_GEMPAK to RMOLDSTD_GEMPAK): Keep only GEMPAK files
    # 3. Full cleanup (older than RMOLDSTD_GEMPAK): Remove everything
    # Note: RMOLDSTD and RMOLDEND remain at standard values for non-GEMPAK data
    :  # No action needed, variables are already set
fi

# Specify the list of files to exclude from the first stage of cleanup
# Because arrays cannot be exported, list is a single string of comma-
# separated values. This string is split to form an array at runtime.
case ${RUN} in
	gdas | gfs)	exclude_string="*prepbufr*, *cnvstat.tar*, *analysis.atm.a*.nc" ;;
	enkf*)      exclude_string="*f006.ens*" ;;
	*)			exclude_string="" ;;
esac
export exclude_string

echo "END: config.cleanup"
